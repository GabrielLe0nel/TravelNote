<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent" android:layout_height="match_parent" android:orientation="vertical"
    android:paddingStart="16dp" android:paddingTop="12dp" android:paddingEnd="16dp" android:paddingBottom="8dp" android:background="@color/cream" tools:context=".MapActivity">
    <TextView android:id="@+id/back_from_map" android:layout_width="match_parent" android:layout_height="44dp" android:gravity="center_vertical" android:text="‹   Caderno de viagem" android:textColor="@color/sage_dark" android:textSize="16sp" android:clickable="true" android:focusable="true" />
    <TextView android:layout_width="match_parent" android:layout_height="42dp" android:text="Mapa das memórias" android:textColor="@color/ink" android:textSize="24sp" android:textStyle="bold" />
    <FrameLayout android:id="@+id/map_container" android:layout_width="match_parent" android:layout_height="0dp" android:layout_marginTop="8dp" android:layout_weight="1" android:background="#E5EBE1">
        <TextView android:id="@+id/map_preview_placeholder" android:layout_width="match_parent" android:layout_height="match_parent" android:gravity="center" android:text="Mapa das memórias" android:textColor="@color/sage_dark" android:textSize="18sp" tools:visibility="visible" android:visibility="gone" />
    </FrameLayout>
</LinearLayout>
