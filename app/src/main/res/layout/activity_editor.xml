<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android" xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent" android:layout_height="match_parent" android:fillViewport="true" tools:context=".EditorActivity">
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical"
        android:paddingStart="22dp" android:paddingTop="24dp" android:paddingEnd="22dp" android:paddingBottom="30dp" android:background="@color/cream">
        <TextView android:id="@+id/back_editor" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="‹   Voltar" android:textColor="@color/sage_dark" android:textSize="16sp" android:clickable="true" android:focusable="true" />
        <TextView android:id="@+id/editor_heading" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="20dp" android:text="Nova memória" android:textColor="@color/ink" android:textSize="28sp" android:textStyle="bold" />
        <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="7dp" android:text="Guarde os detalhes que fazem esse momento especial." android:textColor="@color/muted" android:textSize="14sp" />
        <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="20dp" android:text="TÍTULO" android:textColor="@color/sage_dark" android:textSize="11sp" android:textStyle="bold" />
        <EditText android:id="@+id/input_title" android:layout_width="match_parent" android:layout_height="56dp" android:layout_marginTop="7dp" android:background="@drawable/input_bg" android:gravity="center_vertical" android:hint="Título da memória" android:inputType="textCapSentences" android:padding="14dp" android:textColor="@color/ink" android:textColorHint="#8A918A" android:textSize="15sp" />
        <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="20dp" android:text="SUA HISTÓRIA" android:textColor="@color/sage_dark" android:textSize="11sp" android:textStyle="bold" />
        <EditText android:id="@+id/input_description" android:layout_width="match_parent" android:layout_height="150dp" android:layout_marginTop="7dp" android:background="@drawable/input_bg" android:gravity="top" android:hint="Conte sua experiência..." android:inputType="textCapSentences|textMultiLine" android:padding="14dp" android:textColor="@color/ink" android:textColorHint="#8A918A" android:textSize="15sp" />
        <Button android:id="@+id/button_add_photo" android:layout_width="match_parent" android:layout_height="50dp" android:layout_marginTop="14dp" android:backgroundTint="#E5EBE1" android:text="＋  Adicionar foto (opcional)" android:textAllCaps="false" android:textColor="@color/sage_dark" android:textSize="15sp" />
        <TextView android:id="@+id/photo_label" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Nenhuma foto selecionada" android:textColor="@color/muted" android:textSize="13sp" />
        <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="28dp" android:text="DETALHES DO MOMENTO" android:textColor="@color/sage_dark" android:textSize="12sp" android:textStyle="bold" />
        <TextView android:id="@+id/location_text" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:text="Buscando localização…" android:textColor="@color/sage_dark" android:textSize="14sp" />
        <TextView android:id="@+id/pressure_text" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:text="Aguardando leitura do barômetro…" android:textColor="@color/sage_dark" android:textSize="14sp" />
        <Button android:id="@+id/button_save_memory" android:layout_width="match_parent" android:layout_height="54dp" android:layout_marginTop="28dp" android:backgroundTint="@color/sage" android:text="Salvar memória" android:textAllCaps="false" android:textColor="@color/white" android:textSize="15sp" />
    </LinearLayout>
</ScrollView>
