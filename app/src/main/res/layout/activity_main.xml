<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android" xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent" android:layout_height="match_parent" android:fillViewport="true" tools:context=".MainActivity">
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
        android:orientation="vertical" android:paddingStart="22dp" android:paddingTop="18dp"
        android:paddingEnd="22dp" android:paddingBottom="28dp" android:background="@color/cream">
        <LinearLayout android:layout_width="wrap_content" android:layout_height="wrap_content" android:gravity="center_vertical" android:orientation="horizontal">
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="TRAVELNOTE" android:textColor="@color/sage_dark" android:textSize="12sp" android:letterSpacing="0.12" />
            <ImageView android:id="@+id/brand_mountains" android:layout_width="18dp" android:layout_height="18dp" android:layout_marginStart="7dp" android:contentDescription="Montanhas" android:src="@drawable/ic_mountains_mark" />
        </LinearLayout>
        <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="16dp" android:text="Suas memórias\npelo caminho." android:textColor="@color/ink" android:textSize="30sp" android:textStyle="bold" />
        <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:text="Um diário de viagem, feito de lugares e momentos." android:textColor="@color/muted" android:textSize="14sp" />
        <Button android:id="@+id/button_new_memory" android:layout_width="match_parent" android:layout_height="54dp" android:layout_marginTop="24dp" android:backgroundTint="@color/sage" android:text="＋   Nova memória" android:textAllCaps="false" android:textColor="@color/white" android:textSize="16sp" />
        <Button android:id="@+id/button_map" android:layout_width="match_parent" android:layout_height="48dp" android:layout_marginTop="8dp" android:backgroundTint="#E5EBE1" android:text="Ver mapa das memórias" android:textAllCaps="false" android:textColor="@color/sage_dark" />
        <EditText android:id="@+id/search_memories" android:layout_width="match_parent" android:layout_height="50dp" android:layout_marginTop="22dp" android:background="@drawable/input_bg" android:hint="Buscar memórias" android:inputType="text" android:paddingStart="16dp" android:paddingEnd="16dp" android:singleLine="true" android:textColor="@color/ink" android:textColorHint="@color/muted" android:textSize="15sp" />
        <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="25dp" android:letterSpacing="0.08" android:text="CADERNO DE VIAGEM" android:textColor="@color/sage_dark" android:textSize="12sp" android:textStyle="bold" />
        <TextView android:id="@+id/empty_memories" android:layout_width="match_parent" android:layout_height="150dp" android:gravity="center" android:text="Ainda não há memórias.\nRegistre seu primeiro momento de viagem." android:textColor="@color/muted" android:textSize="15sp" />
        <LinearLayout android:id="@+id/memory_cards" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" />
    </LinearLayout>
</ScrollView>
